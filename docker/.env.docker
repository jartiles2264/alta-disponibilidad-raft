# Variables de entorno para el cluster Docker completo
# Usado por docker-compose.cluster.yml

MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=banco_app
MYSQL_PASSWORD=bancopass123
MYSQL_DATABASE=banco_db
MYSQL_PORT=3306

SIDECAR_MYSQL_USER=sidecar
SIDECAR_MYSQL_PASSWORD=sidecarpass123
MYSQL_REPL_USER=replica_user
MYSQL_REPL_PASSWORD=replicapass123

ETCD_KEY=/banco/mysql/primary
LEASE_TTL=5
CHECK_INTERVAL=2

POOL_SIZE=5
RETRY_MAX=15
FAILOVER_WAIT=30
TRANSFER_INTERVAL=1
